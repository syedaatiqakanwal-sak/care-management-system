# ==========================================
# STRICT SECRETS & ENVIRONMENT EXCLUSIONS
# ==========================================
.env
.env.*
*.env
*.key
*.pem
*.pub
*.sql
*.dump
secrets/
*.secret
*.bat
*.ps1

# ==========================================
# STRICT DOCKER EXCLUSIONS
# ==========================================
docker-compose*
Dockerfile*
*.dockerfile
*.dockerignore
docker/

# ==========================================
# DEPENDENCIES
# ==========================================
node_modules/
**/node_modules/

# ==========================================
# BUILD OUTPUTS
# ==========================================
dist/
**/dist/
dist-ssr/
build/
*.tsbuildinfo

# ==========================================
# USER UPLOADS & RUNTIME MEDIA
# ==========================================
uploads/
**/uploads/
*.pdf
test_cert.pdf

# ==========================================
# LOGS
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

